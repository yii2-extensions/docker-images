# Normalize line endings: every text file is stored and checked out with LF, which shell scripts, Apache and PHP
# configuration copied into the image require.
* text=auto eol=lf

# ...Unless the name matches the following overriding patterns

# Definitively text files
*.php   text
*.css   text
*.js    text
*.txt   text
*.md    text
*.xml   text
*.json  text
*.json5 text
*.neon  text
*.bat   text
*.sql   text
*.yml   text
*.yaml  text
*.svg   text

# Ensure those won't be messed up with
*.png   binary
*.jpg   binary
*.gif   binary
*.ttf   binary

# Exclude development and private files; retain guides and the skill links they reference.
/.editorconfig                  export-ignore
/.gitattributes                 export-ignore
/.github                        export-ignore
/.gitignore                     export-ignore
/.prettierignore                export-ignore
/.prettierrc.json               export-ignore
/internal                       export-ignore

# Avoid merge conflicts in CHANGELOG
# https://about.gitlab.com/2015/02/10/gitlab-reduced-merge-conflicts-by-90-percent-with-changelog-placeholders/
/CHANGELOG.md merge=union
